{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["cypress", "node", "@testing-library/cypress"]
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts", "apps/*/tests/**/*.ts"]
}
