# Copy to .env for local development. Do not use these values outside local development.
UTS_APP_ENVIRONMENT=local
UTS_DATABASE_URL=postgresql://uzair_transport:local-development-only@localhost:5432/uzair_transport
UTS_SUPABASE_JWT_ISSUER=http://localhost:9999
UTS_SUPABASE_JWT_AUDIENCE=authenticated
UTS_SUPABASE_AUTH_URL=http://localhost:9999
UTS_SUPABASE_JWT_SIGNING_KEY=replace-this-with-a-local-32-character-minimum-secret
